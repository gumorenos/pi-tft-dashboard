# Copiar a /etc/dashboard.env (chmod 600, dueño root) y editar.
# Copy to /etc/dashboard.env (chmod 600, owned by root) and edit.
PIHOLE_PASSWORD=change-me
OWM_API_KEY=change-me
OWM_CITY=Lima,PE
# Pi-hole: por defecto la interfaz web está en el puerto 8089; con el puerto estándar usa http://localhost
# Pi-hole: the web interface defaults to port 8089; with the standard port use http://localhost
#PIHOLE_URL=http://localhost:8089
# Idioma de la pantalla / Screen language: es | en
#DASHBOARD_LANG=es
# Mascota de la página 1 / Page 1 pet: beagle | shepherd | tabby | white-cat | none
#DASHBOARD_PET=beagle
# Zona horaria (hora en pantalla y ventana nocturna) / Time zone (on-screen clock and night window)
#DASHBOARD_TZ=America/Lima
# Pantalla en negro de noche (horas locales 0-23), opcional / Black screen at night (local hours 0-23), optional
#NIGHT_START=23
#NIGHT_END=6
